# -----------------------------
# LiteLLM proxy (recommended for VM / production)
# -----------------------------
# Internal URL when the backend runs on the same VM as the proxy (Docker network):
LITELLM_BASE_URL=http://litellm-quantumchatbots:4000
# Public URL for local dev against the shared proxy:
# LITELLM_BASE_URL=https://litellm-quantumchatbots.hybridintelligence.eu
LITELLM_API_KEY=sk-replace-with-virtual-key-from-litellm-ui
LITELLM_DEFAULT_MODEL=claude-haiku-4-5

# Legacy alias (optional; LITELLM_DEFAULT_MODEL takes precedence)
# LLM_MODEL=claude-haiku-4-5

# -----------------------------
# Direct provider keys (local dev without proxy)
# -----------------------------
# Uncomment only if NOT using the LiteLLM proxy:
# MISTRAL_API_KEY=replace_with_your_mistral_key

# -----------------------------
# Runtime mode and API security
# -----------------------------
ENV=dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=45
MAX_RESUME_BYTES=8000

# -----------------------------
# Data layer
# -----------------------------
DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot
INTERACTION_LOG_DB_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot
# USAGE_TRACKER_DB_URL=  # defaults to INTERACTION_LOG_DB_URL or DATABASE_URL

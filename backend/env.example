# -----------------------------
# LLM / LiteLLM configuration
# -----------------------------
# Default model used by the backend gateway.
LLM_MODEL=mistral/mistral-small-latest

# Preferred key variable in this project.
MISTRAL_API_KEY=replace_with_your_mistral_key

# Optional: LiteLLM also supports provider-specific lowercase names.
# If unset, backend code mirrors MISTRAL_API_KEY -> mistral_api_key.
# mistral_api_key=replace_with_your_mistral_key


# -----------------------------
# Runtime mode and API security
# -----------------------------
ENV=dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=45
MAX_RESUME_BYTES=8000

# -----------------------------
# Data layer
# -----------------------------
# Used when enabling Postgres checkpointer / pgvector.
DATABASE_URL=postgresql://user:password@localhost:5432/chatbot
# Optional override for interaction event logging (defaults to DATABASE_URL).
INTERACTION_LOG_DB_URL=postgresql://user:password@localhost:5432/chatbot
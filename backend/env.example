# -----------------------------
# LLM / LiteLLM configuration
# -----------------------------
# Default model used by the backend gateway.
LLM_MODEL=mistral/mistral-small-latest

# Preferred key variable in this project.
MISTRAL_API_KEY=replace_with_your_mistral_key

# Optional: LiteLLM also supports provider-specific lowercase names.
# If unset, backend code mirrors MISTRAL_API_KEY -> mistral_api_key.
# mistral_api_key=replace_with_your_mistral_key


# -----------------------------
# Data layer (optional for now)
# -----------------------------
# Used when enabling Postgres checkpointer / pgvector.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatbot

# -----------------------------
# LLM / LiteLLM configuration
# -----------------------------
# Default model resolved by core/llm.py and core/model_gateway.py.
LLM_MODEL=mistral/mistral-small-latest

# Preferred provider key variable in this project.
MISTRAL_API_KEY=replace_with_your_mistral_key

# Optional: LiteLLM provider-style lowercase key.
# If unset, backend mirrors MISTRAL_API_KEY -> mistral_api_key at runtime.
# mistral_api_key=replace_with_your_mistral_key


# -----------------------------
# Runtime mode and API security
# -----------------------------
# Use "dev" for local development and "prod" for hosted environments.
ENV=dev

# Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Basic request-rate limiting on /api/chat.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=45

# Maximum request body size accepted for resume payloads.
MAX_RESUME_BYTES=8000


# -----------------------------
# Data layer
# -----------------------------
# Postgres connection string used by LangGraph checkpointer.
# Example for Supabase/Neon:
# DATABASE_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/chatbot

# Optional override for interaction logging DB (defaults to DATABASE_URL).
INTERACTION_LOG_DB_URL=postgresql://user:password@localhost:5432/chatbot

# Optional limits for persisted interaction payload sizes.
INTERACTION_LOG_MAX_MESSAGE_CHARS=4000
INTERACTION_LOG_MAX_PAYLOAD_CHARS=12000
